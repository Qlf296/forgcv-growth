# ============================================================
# FORGCV GROWTH COMMAND CENTER — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_FORGCV_URL=https://forgcv.com

# ── Supabase (free tier: supabase.com) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Claude AI (Anthropic) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram Notifications ───────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ── Instagram (Meta Graph API) ───────────────────────────────
# Requires: Instagram Professional Account + Meta Developer App
# Permissions: instagram_basic, instagram_content_publish, instagram_manage_insights
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── TikTok (TikTok for Developers) ───────────────────────────
# Requires: Developer account + app review for publishing
# Note: Direct posting API requires platform audit approval
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── LinkedIn ─────────────────────────────────────────────────
# Requires: LinkedIn Developer App with w_member_social permission
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ── Reddit ───────────────────────────────────────────────────
# Requires: Reddit app (script type) at reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=ForgCV-Growth-Bot/1.0 by ForgCV

# ── X / Twitter ──────────────────────────────────────────────
# Requires: Developer portal with Elevated access + OAuth2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ── Redis (Upstash free tier: upstash.com) ───────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Google Analytics (optional) ──────────────────────────────
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_KEY=

# ── Timezone ─────────────────────────────────────────────────
TZ=Europe/Amsterdam
